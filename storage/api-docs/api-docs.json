            "delete": {
                "tags": [
                    "institucion"
                ],
                "summary": "Delete an Institution By Id",
                "description": "Método para eliminar una institución",
                "operationId": "delete an institution",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Id of institution",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Institution deleted",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "nombre": {
                                            "type": "string",
                                            "example": "Univalle"
                                        },
                                        "tipo": {
                                            "type": "string",
                                            "example": "publica"
                                        },
                                        "Capacidad": {
                                            "type": "integer",
                                            "example": 1500
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Institution not deleted"
                    }
                }
            }
        },
        "/institution/update": {
            "put": {
                "tags": [
                    "institucion"
                ],
                "summary": "Update an institution",
                "description": "Método para actualizar una institución",
                "operationId": "update institution",
                "requestBody": {
                    "description": "Institution data",
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "nombre": {
                                        "type": "string",
                                        "example": "Univalle"
                                    },
                                    "tipo": {
                                        "type": "string",
                                        "example": "publica"
                                    },
                                    "Capacidad": {
                                        "type": "integer",
                                        "example": 1500
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Institution updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "nombre": {
                                            "type": "string",
                                            "example": "Univalle"
                                        },
                                        "tipo": {
                                            "type": "string",
                                            "example": "publica"
                                        },
                                        "Capacidad": {
                                            "type": "integer",
                                            "example": 1500
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "request failed"
                    }
                }
            }
        }
    },
